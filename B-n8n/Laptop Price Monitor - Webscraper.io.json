    {
      "parameters": {
        "jsCode": "const currentProducts = $('Normalize Products').all();\nconst previousRows = $('Read Latest Prices').all();\n\nconst previousByLink = new Map();\n\nfor (const item of previousRows) {\n  const row = item.json;\n\n  if (row.link) {\n    previousByLink.set(row.link, row);\n  }\n}\n\nreturn currentProducts.map(item => {\n  const product = item.json;\n  const previous = previousByLink.get(product.link);\n\n  let status = 'unchanged';\n  let old_price = null;\n\n  if (!previous) {\n    status = 'new';\n  } else {\n    old_price = Number(previous.price);\n\n    if (old_price !== Number(product.price)) {\n      status = 'price_changed';\n    }\n  }\n\n  return {\n    json: {\n      ...product,\n      old_price,\n      status,\n      timestamp: new Date().toISOString()\n    }\n  };\n});"
      },
