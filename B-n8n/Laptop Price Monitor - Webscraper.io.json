    {
      "parameters": {
        "jsCode": "const pages = [];\n\nfor (let i = 1; i <= 20; i++) {\n  pages.push({\n    json: {\n      page: i,\n      url: `https://webscraper.io/test-sites/e-commerce/static/computers/laptops?page=${i}`\n    }\n  });\n}\n\nreturn pages;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        352
      ],
      "id": "5dad6b21-74d1-4224-bc4b-878cddd0a5ee",
      "name": "Generate Page URLs"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const names = item.json.name || [];\n  const prices = item.json.price || [];\n  const reviews = item.json.reviews || [];\n  const links = item.json.link || [];\n\n  const count = Math.min(\n    names.length,\n    prices.length,\n    reviews.length,\n    links.length\n  );\n\n  for (let i = 0; i < count; i++) {\n    const price = Number(\n      String(prices[i]).replace(\"$\", \"\").trim()\n    );\n\n    const reviewMatch = String(reviews[i]).match(/\\d+/);\n    const reviewCount = reviewMatch ? Number(reviewMatch[0]) : 0;\n\n    const rawLink = links[i];\n    const fullLink = rawLink.startsWith(\"http\")\n      ? rawLink\n      : `https://webscraper.io${rawLink}`;\n\n    output.push({\n      json: {\n        name: String(names[i]).trim(),\n        price,\n        reviews: reviewCount,\n        link: fullLink\n      }\n    });\n  }\n}\n\nreturn output;"
      },
